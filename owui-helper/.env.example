# Open WebUI Configuration
SENSITIVE_KEY=MASTER-KEY-HERE
VOLUME_NAME=open-webui
CONTAINER_NAME=owui-helper
OPEN_WEBUI_PORT=3000
WEBUI_DOCKER_TAG=main

# UI Configuration
OFFLINE_MODE=True
WEBUI_NAME=Kranti
WEBUI_AUTH=False

# Model Configuration
TASK_MODEL_EXTERNAL=gemini-2.0-flash
DEFAULT_MODELS=deepseek-v3
ENABLE_OLLAMA_API=False
ENABLE_COMMUNITY_SHARING=False
ENABLE_MESSAGE_RATING=False
ENABLE_TAGS_GENERATION=False
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=m2-bert-80M-8k
AUDIO_STT_ENGINE=openai
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_MODEL=kokoro-tts
AUDIO_TTS_VOICE=af_bella

# API Configuration
OPENAI_API_BASE_URL=http://host.docker.internal:4000/v1
PROXY_API_KEY=${SENSITIVE_KEY}
AUDIO_TTS_OPENAI_API_BASE_URL=http://host.docker.internal:4000/v1
AUDIO_TTS_OPENAI_API_KEY=${SENSITIVE_KEY}